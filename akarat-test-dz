      </div>

      <div class="field">
        <label>بحث بالاسم</label>
        <input type="search" id="searchInput" placeholder="مثلاً: فيلا فاخرة">
      </div>

      <button class="btn btn-gold" onclick="filterProperties()">بحث عن عقار</button>
    </div>
  </div>
</section>

<section class="section" id="properties">
  <div class="container">

    <div class="section-heading">
