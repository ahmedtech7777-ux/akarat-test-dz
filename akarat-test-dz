<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#171914">
<meta name="description" content="دار العقار - وكالة عقارية لعرض الشقق والمنازل والفلل للبيع والإيجار.">
<title>DAR IMMO | دار العقار</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root{
  --dark:#171914;
  --dark2:#22251e;
  --gold:#c7a76a;
  --gold-light:#e4cc9e;
  --cream:#f7f4ed;
  --white:#fff;
  --gray:#77796f;
  --border:#e9e5dc;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Cairo',sans-serif;
  background:var(--cream);
  color:var(--dark);
  line-height:1.8;
}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font-family:inherit}
button{cursor:pointer}
.container{width:min(1150px,92%);margin:auto}

/* HEADER */
header{
  position:sticky;top:0;z-index:100;
  background:rgba(23,25,20,.97);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.navbar{
  min-height:78px;display:flex;
  align-items:center;justify-content:space-between;
  gap:20px;
}
.logo{
  color:var(--white);font-size:23px;
  font-weight:900;direction:ltr;
}
.logo span{color:var(--gold)}
.nav-links{display:flex;gap:27px;color:#ddd;font-size:13px}
.nav-links a:hover{color:var(--gold)}
.nav-btn{
  background:var(--gold);color:var(--dark);
  padding:9px 17px;border-radius:5px;
  font-weight:800;font-size:12px;
}

/* HERO */
.hero{
  min-height:590px;
  display:flex;align-items:center;
  position:relative;
  background:
  linear-gradient(90deg,rgba(12,15,11,.82),rgba(12,15,11,.35)),
  url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1800') center/cover;
  color:white;
}
.hero-content{max-width:650px;padding:100px 0}
.hero-label{
  color:var(--gold-light);font-size:13px;
  font-weight:700;letter-spacing:1px;
}
.hero h1{
  font-size:clamp(35px,6vw,64px);
  line-height:1.4;margin:16px 0;
  font-weight:900;
}
.hero h1 span{color:var(--gold-light)}
.hero p{color:#e1e0d9;font-size:15px;max-width:530px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:12px 23px;border-radius:5px;
  font-size:13px;font-weight:800;border:0;
}
.btn-gold{background:var(--gold);color:var(--dark)}
.btn-outline{border:1px solid rgba(255,255,255,.6);color:white}
.btn:hover{filter:brightness(1.1)}

/* SEARCH */
.search-section{position:relative;margin-top:-45px;z-index:5}
.search-box{
  background:white;padding:24px;
  border-radius:9px;
  box-shadow:0 12px 40px rgba(0,0,0,.1);
  display:grid;grid-template-columns:repeat(4,1fr) auto;
  gap:12px;align-items:end;
}
.field label{display:block;font-size:11px;font-weight:800;margin-bottom:5px}
.field input,.field select{
  width:100%;height:44px;
  border:1px solid var(--border);
  border-radius:5px;padding:0 10px;
  background:#fff;color:var(--dark);outline:none;
}
.field input:focus,.field select:focus{border-color:var(--gold)}

/* SECTIONS */
.section{padding:90px 0}
.section-heading{text-align:center;margin-bottom:40px}
.section-heading small{color:#a78348;font-weight:800;font-size:12px}
.section-heading h2{font-size:32px;font-weight:900;margin:7px 0}
.section-heading p{font-size:13px;color:var(--gray)}
.properties-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:24px;
}
.property-card{
  background:white;border-radius:8px;
  overflow:hidden;border:1px solid var(--border);
  transition:.3s;
}
.property-card:hover{
  transform:translateY(-5px);
  box-shadow:0 12px 30px rgba(0,0,0,.08);
}
.property-image{height:220px;position:relative;overflow:hidden}
.property-image img{
  width:100%;height:100%;object-fit:cover;transition:.4s;
}
.property-card:hover .property-image img{transform:scale(1.05)}
.status{
  position:absolute;top:13px;right:13px;
  background:var(--gold);color:#1b1b16;
  padding:4px 12px;border-radius:3px;
  font-size:10px;font-weight:900;
}
.property-content{padding:18px}
.property-location{font-size:11px;color:var(--gray)}
.property-content h3{font-size:17px;margin:5px 0}
.property-description{font-size:12px;color:var(--gray);min-height:45px}
.property-features{
  display:flex;justify-content:space-between;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  margin:14px 0;padding:10px 0;
  font-size:11px;color:#5e6159;
}
.property-bottom{
  display:flex;align-items:center;justify-content:space-between;
  gap:8px;
}
.price{color:#9a743c;font-size:17px;font-weight:900}
.details-btn{
  background:var(--dark);color:white;
  border:0;border-radius:4px;
  padding:8px 14px;font-size:11px;font-weight:800;
}
.details-btn:hover{background:#9a743c}
.empty{
  display:none;text-align:center;
  color:var(--gray);padding:50px 10px;
  grid-column:1/-1;
}

/* ABOUT */
.about{
  background:var(--dark);color:white;
  padding:85px 0;
}
.about-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:50px;align-items:center;
}
.about-image{height:370px;border-radius:7px;overflow:hidden}
.about-image img{width:100%;height:100%;object-fit:cover}
.about small{color:var(--gold)}
.about h2{font-size:34px;margin:10px 0 17px}
.about p{font-size:13px;color:#c5c7bc}
.about-list{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:25px}
.about-item{border-right:2px solid var(--gold);padding-right:12px}
.about-item strong{display:block;color:var(--gold-light);font-size:18px}
.about-item span{font-size:11px;color:#ccc}

/* SERVICES */
.services-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
}
.service{
  background:white;border:1px solid var(--border);
  padding:27px 20px;text-align:center;border-radius:7px;
}
.service-icon{font-size:30px;margin-bottom:10px}
.service h3{font-size:16px;margin-bottom:6px}
.service p{font-size:12px;color:var(--gray)}

/* CONTACT */
.contact{
  background:#eae4d7;padding:80px 0;text-align:center;
}
.contact h2{font-size:30px;font-weight:900}
.contact p{font-size:13px;color:var(--gray);margin:10px 0 22px}
.contact-form{
  max-width:650px;margin:25px auto 0;
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
}
.contact-form input,.contact-form textarea{
  width:100%;padding:12px;
  border:1px solid #d9d2c4;border-radius:5px;
  outline:none;background:white;
}
.contact-form textarea{grid-column:1/-1;resize:vertical}
.contact-form button{grid-column:1/-1}

/* FOOTER */
footer{
  background:#11130f;color:#aaa;
  padding:25px 0;text-align:center;font-size:11px;
}
footer strong{color:var(--gold)}

/* MODAL */
.modal{
  display:none;position:fixed;inset:0;z-index:300;
  background:rgba(0,0,0,.75);
  padding:20px;align-items:center;justify-content:center;
}
.modal.show{display:flex}
.modal-box{
  background:white;width:min(650px,100%);
  max-height:90vh;overflow:auto;
  border-radius:8px;position:relative;
}
.modal-box img{width:100%;height:260px;object-fit:cover}
.modal-body{padding:23px}
.modal-body h2{font-size:23px}
.modal-body p{font-size:13px;color:var(--gray);margin:10px 0}
.modal-close{
  position:absolute;top:12px;left:12px;
  width:35px;height:35px;border:0;
  border-radius:50%;background:white;
  font-size:20px;
}
.modal-price{color:#99743d;font-size:22px;font-weight:900}

@media(max-width:850px){
  .search-box{grid-template-columns:repeat(2,1fr)}
  .properties-grid{grid-template-columns:repeat(2,1fr)}
  .about-grid{gap:25px}
}
@media(max-width:650px){
  .nav-links{display:none}
  .hero{min-height:520px}
  .hero-content{padding:75px 0}
  .hero p{font-size:13px}
  .search-box{grid-template-columns:1fr 1fr;padding:16px}
  .search-box .btn{grid-column:1/-1}
  .properties-grid{grid-template-columns:1fr}
  .property-image{height:230px}
  .about-grid{grid-template-columns:1fr}
  .about-image{height:250px;order:2}
  .services-grid{grid-template-columns:1fr}
  .section{padding:65px 0}
  .section-heading h2{font-size:26px}
}
@media(max-width:380px){
  .search-box{grid-template-columns:1fr}
  .search-box .btn{grid-column:auto}
  .contact-form{grid-template-columns:1fr}
  .contact-form textarea,.contact-form button{grid-column:auto}
}
</style>
</head>

<body>

<header>
  <div class="container navbar">
    <a href="#" class="logo">DAR <span>IMMO.</span></a>
    <nav class="nav-links">
      <a href="#home">الرئيسية</a>
      <a href="#properties">العقارات</a>
      <a href="#about">من نحن</a>
